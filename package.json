{
  "name": "osu-files",
  "version": "1.0.0",
  "description": "Read, modify, and import osu!lazer Realm data and osu! file formats.",
  "license": "MIT",
  "author": "heyn",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:public": "tsc -p tsconfig.type-tests.json --noEmit",
    "test:ci": "npm run typecheck && npm test",
    "prepublishOnly": "npm run test:ci && npm run build",
    "test": "node tests/run-tests.js",
    "test:int": "node tests/run-tests.js",
    "test:docs": "node tests/run-tests.js tests/docs",
    "docs:fixture": "tsx tools/docs/generate-realm-fixture.ts",
    "docs:api": "typedoc --options typedoc.config.mjs",
    "docs:manifest": "tsx tools/docs/generate-api-manifest.ts",
    "docs:guides": "tsx tools/docs/generate-guides.ts",
    "docs:excludes": "tsx tools/docs/apply-api-excludes.ts",
    "docs:facades": "tsx tools/docs/generate-facade-pages.ts",
    "docs:normalize": "tsx tools/docs/normalize-function-pages.ts",
    "docs:api-examples": "tsx tools/docs/generate-api-examples.ts",
    "docs:runner-types": "tsx tools/docs/generate-runner-types.ts",
    "docs:check": "tsx tools/docs/check-docs.ts",
    "docs:generate": "npm run build && npm run docs:fixture && npm run docs:api && npm run docs:manifest && npm run docs:guides && npm run docs:excludes && npm run docs:facades && npm run docs:normalize && npm run docs:api-examples && npm run docs:runner-types",
    "docs:build": "npm run docs:generate && npm run docs:check && vitepress build docs",
    "docs:dev": "tsx tools/docs/dev.ts",
    "docs:test": "playwright test"
  },
  "dependencies": {
    "lzma-web": "^3.0.1",
    "realm": "^20.1.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@shikijs/vitepress-twoslash": "2.5.0",
    "@types/node": "^26.1.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "monaco-editor": "^0.53.0",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.7",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13"
  },
  "overrides": {
    "vite": "6.4.3",
    "esbuild": "0.25.12"
  }
}
