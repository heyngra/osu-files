{
  "name": "osu-files",
  "version": "1.0.0",
  "description": "Read, modify, and import osu!lazer Realm data and osu! file formats.",
  "license": "MIT",
  "author": "heyn",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:public": "tsc -p tsconfig.type-tests.json --noEmit",
    "test:ci": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build",
    "test": "node tests/run-tests.js",
    "test:int": "node tests/run-tests.js"
  },
  "dependencies": {
    "lzma-web": "^3.0.1",
    "realm": "^20.1.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
